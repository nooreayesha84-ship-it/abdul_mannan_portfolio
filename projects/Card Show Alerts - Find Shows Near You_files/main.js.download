// Main JavaScript for Card Show Alerts

document.addEventListener('DOMContentLoaded', function () {
    // Initialize date pickers if needed
    const dateInputs = document.querySelectorAll('.date-input');
    dateInputs.forEach(input => {
        // Set min date to today
        const today = new Date().toISOString().split('T')[0];
        input.setAttribute('min', today);
    });

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        });
    });

    // Auto-hide messages after 5 seconds
    const alerts = document.querySelectorAll('.alert');
    alerts.forEach(alert => {
        setTimeout(() => {
            alert.style.opacity = '0';
            alert.style.transition = 'opacity 0.5s ease';
            setTimeout(() => alert.remove(), 500);
        }, 5000);
    });

    // Show signup modal after 5 seconds for non-authenticated users
    const signupModal = document.getElementById('signupModal');
    if (signupModal) {
        // Check if user has dismissed the modal in this session
        const hasSeenModal = sessionStorage.getItem('signupModalSeen');
        
        if (!hasSeenModal) {
            setTimeout(() => {
                signupModal.classList.add('show');
            }, 5000);
        }
    }
});

// Close signup modal function
function closeSignupModal() {
    const modal = document.getElementById('signupModal');
    if (modal) {
        modal.classList.remove('show');
        // Remember that user has seen the modal for this session
        sessionStorage.setItem('signupModalSeen', 'true');
    }
}

// Close modal when clicking outside of it
window.onclick = function(event) {
    const modal = document.getElementById('signupModal');
    if (event.target === modal) {
        closeSignupModal();
    }
}
